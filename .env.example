# 假配置。不要写入真实密钥。留空 URAG_EMBED_ENDPOINT 才会使用夹具嵌入。
URAG_ADDR=:8080
URAG_DATA_DIR=./data
URAG_STORAGE=local
URAG_S3_ENDPOINT=https://s3.example.invalid
URAG_S3_REGION=example-region
URAG_S3_BUCKET=example-bucket
URAG_S3_ACCESS_KEY=example-access-key
URAG_S3_SECRET_KEY=example-secret-key
URAG_S3_PATH_STYLE=true
URAG_EMBED_ENDPOINT=http://embed.example.invalid/v1/embeddings
URAG_EMBED_MODEL=example-embed
URAG_EMBED_API_KEY=example-not-a-real-key
URAG_EMBED_BATCH_SIZE=16
URAG_EMBED_CONCURRENCY=2
URAG_CLEAN_CONCURRENCY=2
URAG_UPLOAD_CONCURRENCY=2
URAG_PART_SIZE=5242880
URAG_RETRY_MAX=3
URAG_VECTOR_WEIGHT=0.7
URAG_KEYWORD_WEIGHT=0.3
URAG_CHUNK_MAX_LEN=800
URAG_CHUNK_OVERLAP=100
URAG_FIXTURE=testdata/recall/fixture.json
URAG_INLINE_JOBS=false
